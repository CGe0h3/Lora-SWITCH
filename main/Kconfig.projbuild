menu "Heltec multi-boot menu"

    choice MB_BOARD
        prompt "Board"
        default MB_BOARD_V4
        config MB_BOARD_V4
            bool "Heltec WiFi LoRa 32 V4 (ESP32-S3R2)"
        config MB_BOARD_V4_R8
            bool "Heltec WiFi LoRa 32 V4-R8 (ESP32-S3R8)"
    endchoice

    config MB_AUTOBOOT_SECONDS
        int "Seconds before booting the last firmware automatically"
        range 0 60
        default 5

    config MB_LONG_PRESS_MS
        int "Long press (ms) on PRG to start the selected firmware"
        default 700

endmenu
